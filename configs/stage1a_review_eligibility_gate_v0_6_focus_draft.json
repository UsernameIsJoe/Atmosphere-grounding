{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage1A full-review gate v0.6 review-focus-first draft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "review_focus": {
      "type": "string",
      "enum": [
        "place",
        "encounter",
        "mixed"
      ]
    },
    "focus_summary": {
      "type": "string",
      "minLength": 1
    },
    "keep": {
      "type": "boolean"
    },
    "anchor_quote": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "review_focus",
    "focus_summary",
    "keep",
    "anchor_quote",
    "reason"
  ]
}
